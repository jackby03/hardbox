# Normalise line endings on checkout. The repository stores LF; without this,
# a Windows checkout with core.autocrlf=true rewrites every file to CRLF, which
# makes gofmt and golangci-lint report the entire tree as unformatted while the
# same commit passes on Linux CI.
* text=auto eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.zip binary
*.tar.gz binary
*.gz binary

# Test fixtures that intentionally carry odd bytes.
internal/**/testdata/** -text
